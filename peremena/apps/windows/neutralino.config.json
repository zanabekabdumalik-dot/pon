{
  "applicationId": "app.peremena",
  "applicationName": "Перемена",
  "description": "Перемена — фокус-таймер с разминкой",
  "author": "Школьный проект, 11 класс",
  "copyright": "",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 47823,
  "documentRoot": "/resources/",
