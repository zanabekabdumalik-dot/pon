# ─── GeneGuard AI configuration ──────────────────────────────────────────────
# Copy this file to `.env` and fill in the values you need.
# The app works WITHOUT any keys: demo mode, OCR, the knowledge base and the
# built-in (rule-based) explanations and chat all run locally.

# Port for the web server
PORT=5173

# ─── AI (Anthropic Claude) — optional ───────────────────────────────────────
# Enables AI-written plain-language explanations, the AI chat and the optional
# "AI Vision" OCR for difficult photos. Get a key at https://console.anthropic.com/
# The key is used ONLY on the server and is never sent to the browser.
ANTHROPIC_API_KEY=
# Model used for explanations, chat and vision OCR
AI_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high
AI_EFFORT=medium

# ─── Live ClinVar lookup (NCBI E-utilities) — optional ──────────────────────
# When true, users may opt in to look up rsIDs that are not in the built-in
# knowledge base in NCBI ClinVar. Only rsIDs are sent, never names or files.
ENABLE_CLINVAR_LOOKUP=false
# Optional NCBI API key (raises the rate limit from 3 to 10 requests/second)
NCBI_API_KEY=
