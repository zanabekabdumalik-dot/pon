{
  "name": "geneguard-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GeneGuard AI — educational prototype that explains genetic test results with AI",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tesseract.js": "^6.0.1",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "~1.56.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \"./src/**\" server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts --prod",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "samples": "node scripts/generate-samples.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "build:android": "node scripts/build-app.mjs android",
    "build:desktop": "node scripts/build-app.mjs desktop",
    "app-icons": "node scripts/generate-app-icons.mjs"
