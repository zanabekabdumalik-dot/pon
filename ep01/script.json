{
  "title": "Фобия №1 из 100 — Гиппопотомонстросесквиппедалиофобия",
  "voice": "ru_RU-ruslan-medium",
  "length_scale": 1.0,
  "noise_scale": 0.6,
  "noise_w": 0.7,
  "voice_fx": "volume=-3dB,highpass=f=60,equalizer=f=140:t=q:w=1.0:g=3,equalizer=f=3000:t=q:w=1.5:g=-2,deesser=i=0.5,treble=g=-3:f=7000,acompressor=threshold=-20dB:ratio=2.5:attack=15:release=200:makeup=2",
  "lead_in": 0.35,
  "lines": [
    { "id": "l1", "text": "Эта фобия пугает уже своим названием!", "hide_caption": true },
    { "id": "l2", "text": "Знакомьтесь, это Петя." },
    { "id": "l3", "text": "Петя боится длинных слов." },
    { "id": "l4", "text": "Короткие слова — кот, дом, суп — Петя просто обожает." },
    { "id": "l5", "text": "Но стоит появиться слову подлиннее…", "pause": 0.3 },
    { "id": "l6", "text": "Достопримечательность!" },
    { "id": "l7", "text": "…и у Пети паника!" },
    { "id": "l8", "text": "Как же называется этот страх? Барабанная дробь…", "pause": 1.4 },
    { "id": "l9", "text": "Гиппопотомонстросесквиппедалиофобия!", "hide_caption": true, "pause": 0.7 },
    { "id": "l10", "text": "Да-да! Страх длинных слов называется словом из тридцати пяти букв." },
    { "id": "l11", "text": "Название придумали в шутку." },
    { "id": "l12", "text": "Гиппопото — от гиппопотама, монстро — от монстра." },
    { "id": "l13", "text": "Сесквипедалис по-латыни — «длиной в полтора фута»." },
    { "id": "l14", "text": "А фобия — это страх." },
    { "id": "l15", "text": "Есть и вариант покороче — сесквипедалофобия.", "pause": 1.3 },
    { "id": "l16", "text": "Но Пете, кажется, уже всё равно." },
    { "id": "l17", "text": "Это фобия номер один из ста. Какую разобрать следующей? Пиши в комментариях!", "pause": 1.6 }
  ]
}
