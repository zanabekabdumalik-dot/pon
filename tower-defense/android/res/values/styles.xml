<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="game_bg">#0B1412</color>
    <!-- Dark window from the first frame, so the app never flashes white while the WebView starts. -->
    <style name="GameTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/game_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
